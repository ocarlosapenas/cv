#!/bin/sh
# Check the recorded message of every commit in a range against the commit rule.
# Usage: tools/check-commit-range <git rev-list arguments>
#   tools/check-commit-range BASE..HEAD     every commit of a pull request
#   tools/check-commit-range -1 SHA         one commit
# Used by CI (pull requests and every push to main). Exit 1 if any commit fails.
set -eu

checker="$(dirname "$0")/check-commit-msg"
message=$(mktemp)
trap 'rm -f "$message"' EXIT

status=0
for sha in $(git rev-list --reverse "$@"); do
  git log -1 --format=%B "$sha" > "$message"
  short=$(printf '%s' "$sha" | cut -c1-7)
  if sh "$checker" --recorded "$message"; then
    echo "ok   $short"
  else
    echo "FAIL $short"
    status=1
  fi
done
exit "$status"
