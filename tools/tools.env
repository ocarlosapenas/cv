# Toolchain pins for the cvkit image. Read by tools/build.sh and tools/run, locally and
# in CI. Bumping a pin is a conscious act: every artifact must be at least
# 2 days old, and its checksum is recomputed and recorded here.

# Typst v0.15.1, published 2026-07-17. SHA256s are the GitHub release asset digests.
TYPST_VERSION=0.15.1
TYPST_SHA256_AMD64=a6d077d0a95eed5a2eba715b2dae06be954f624ccbf85758a03f389ded33118c
TYPST_SHA256_ARM64=5aa8d74a3d906e60ea12a66ac2f37f8eef1b14cbad7182a745e393a10c23dcee

# debian:trixie-slim multi-arch index, created 2026-10-05.
BASE_IMAGE=debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

# Lint, scan and link tools (Phase 3). Upstream release binaries, verified by SHA256
# per arch exactly like Typst. Digests are the GitHub release asset digests.

