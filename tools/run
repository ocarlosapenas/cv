#!/usr/bin/env bash
# Run one command inside the pinned cvkit container.
# Usage (from the repository root): tools/run [--net] <command> [args...]
#
# Same isolation baseline as dockerized-tools: only the repository is mounted, no
# network, no capabilities, read-only root, files owned by the host user.
# --net is the one exception: it gives the command network access. Only the link
# check (make links) uses it.
set -euo pipefail

network=(--network none)
if [ "${1:-}" = "--net" ]; then
  network=()
  shift
fi

IMAGE="cv/cvkit:pinned"
TOOLS_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$TOOLS_DIR")"

# Paths inside the container are relative to /work, so it must be the repository.
if [ "$PWD" != "$REPO_DIR" ]; then
  echo "tools/run: run from the repository root ($REPO_DIR)." >&2
  exit 1
fi

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "tools/run: image $IMAGE not found. Run tools/build.sh first." >&2
  exit 1
fi

want="$(cat "$TOOLS_DIR/Dockerfile" "$TOOLS_DIR/tools.env" | shasum -a 256 | cut -d' ' -f1)"
have="$(docker image inspect --format '{{ index .Config.Labels "cv.toolchain.hash" }}' "$IMAGE")"
if [ "$want" != "$have" ]; then
  echo "tools/run: image $IMAGE is stale (tools/Dockerfile or tools/tools.env changed)." >&2
  echo "Run tools/build.sh to rebuild it." >&2
  exit 1
fi

# Attach a TTY only when there is one, so make and pipelines keep working.
tty_flags=()
if [ -t 0 ] && [ -t 1 ]; then tty_flags=(-it); fi

# git inside the container must trust the mounted repository (gitleaks, history scan).
exec docker run --rm ${tty_flags[@]+"${tty_flags[@]}"} \
  ${network[@]+"${network[@]}"} \
  --user "$(id -u):$(id -g)" \
  -e HOME=/tmp \
  -e PYTHONDONTWRITEBYTECODE=1 \
  -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0=/work \
  -v "$PWD":/work -w /work \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --read-only --tmpfs /tmp \
  "$IMAGE" "$@"
