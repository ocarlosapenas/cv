#!/bin/sh
# Commit subject rule for this repository, shared by the commit-msg hook and CI.
# Usage: tools/check-commit-msg [--recorded] <message-file>
#
# The message must be exactly one line matching RULE: no scope, no body, no trailer,
# and no special character other than the colon after the type.
#
# Without --recorded (the commit-msg hook) the file is git's edit buffer: comment lines
# and everything from the scissors line (git commit -v) on are dropped, as git does.
# With --recorded (CI, on `git log --format=%B`) every line is part of the commit, so
# nothing is dropped except blank lines at the start and the end.
set -eu

RULE='^(feat|fix|chore): [A-Za-z0-9 ]+$'

recorded=0
if [ "${1:-}" = "--recorded" ]; then
  recorded=1
  shift
fi

if [ "$recorded" -eq 1 ]; then
  body=$(cat "$1")
else
  body=$(sed -e '/^# -* >8 -*$/,$d' -e '/^#/d' "$1")
fi
message=$(printf '%s\n' "$body" | awk '
  { line[NR] = $0; if ($0 ~ /[^[:space:]]/) { if (!first) first = NR; last = NR } }
  END { if (first) for (i = first; i <= last; i++) print line[i] }')

fail() {
  echo "commit message rejected: $1" >&2
  echo "  rule: one line matching $RULE" >&2
  if [ -n "$message" ]; then
    echo "  got:  $(printf '%s\n' "$message" | head -n 1)" >&2
  fi
  exit 1
}

[ -n "$message" ] || fail "empty message"
[ "$(printf '%s\n' "$message" | wc -l | tr -d ' ')" -eq 1 ] || fail "more than one line (no body, no trailers)"
printf '%s\n' "$message" | grep -Eq "$RULE" || fail "subject does not match the rule"
