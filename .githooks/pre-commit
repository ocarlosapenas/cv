#!/bin/sh
# Checks on the staged changes, all inside the pinned image (tools/run).
# Enabled by `make hooks`. CI runs the same tools over the whole tree (make lint).
set -eu
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# Secrets in the staged diff (the finding is redacted in the output).
tools/run gitleaks git --pre-commit --staged --redact --no-banner .

# Text files only: git grep -I skips binary files. Paths in this repo have no spaces.
text=$(printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 git grep -I --cached -l -e '' -- 2>/dev/null || true)
if [ -n "$text" ]; then
  # Scan what is staged, not the working copy (they differ after `git add -p`): each
  # staged text file is written under build/.staged/ (gitignored, visible to tools/run).
  trap 'rm -rf build/.staged' EXIT
  rm -rf build/.staged
  copies=""
  for f in $text; do
    mkdir -p "build/.staged/$(dirname "$f")"
    git show ":$f" > "build/.staged/$f"
    copies="$copies build/.staged/$f"
  done
  # Confidential terms: reported by deny-list line number, never by the term.
  # shellcheck disable=SC2086
  tools/run python3 scripts/check_denylist.py --denylist private/denylist.local $copies
  # shellcheck disable=SC2086
  tools/run codespell $copies
fi

if printf '%s\n' "$staged" | grep -q '^\.github/workflows/'; then
  tools/run actionlint
  tools/run zizmor --offline .github/workflows
fi

if printf '%s\n' "$staged" | grep -Eq '^(cv\.yaml|skills\.yaml|template/|scripts/|schemas/|tools/)'; then
  make check
fi
